# Copy to .env and adjust. Every setting is optional - defaults run locally with SQLite.

# --- storage ---------------------------------------------------------------
# SQLite (default, zero setup):
JMI_DATABASE_URL=sqlite:///data/jobs.db
# Postgres (what docker-compose uses):
# JMI_DATABASE_URL=postgresql+psycopg://jmi:jmi@localhost:5432/jmi

# --- crawling etiquette ----------------------------------------------------
# Identify yourself honestly: a real contact address is what lets a site owner
# reach you instead of silently blocking you.
JMI_USER_AGENT=JobMarketIntel/1.0 (+https://github.com/yourname/job-market-intel; you@example.com)
JMI_RATE_LIMIT_PER_SECOND=0.75
JMI_RESPECT_ROBOTS=true
JMI_REQUEST_TIMEOUT=30
JMI_MAX_RETRIES=4

# --- sources ---------------------------------------------------------------
JMI_ENABLED_SOURCES=["remoteok","weworkremotely","hackernews","greenhouse","lever","mustakbil","himalayas","arbeitnow"]
JMI_HN_THREADS=2
JMI_GREENHOUSE_BOARDS=["stripe","figma","databricks","discord","anthropic","airtable","gitlab","reddit","robinhood","coinbase"]
JMI_GREENHOUSE_MAX_PER_BOARD=250
JMI_LEVER_BOARDS=["palantir","gopuff","angellist"]
JMI_LEVER_MAX_PER_BOARD=250
# Mustakbil needs one request per posting, so keep this modest.
JMI_MUSTAKBIL_MAX_JOBS=140
JMI_MUSTAKBIL_SITEMAP_PAGES=2
JMI_HIMALAYAS_MAX_JOBS=300
JMI_ARBEITNOW_PAGES=3

# --- scheduling ------------------------------------------------------------
JMI_SCRAPE_INTERVAL_MINUTES=360
JMI_STALE_AFTER_DAYS=45

# --- misc ------------------------------------------------------------------
JMI_ARCHIVE_RAW=true
JMI_LOG_LEVEL=INFO
